{
  "name": "mask-me-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "preview": "vite preview",
    "preview:debug": "vite preview --outDir dist-debug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/check-staged-format.mjs",
    "test": "vitest run",
    "prepare": "husky",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm build:debug"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/three": "0.185.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.3.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.185.1"
  }
}
